<script>
(function(){
  /* ================== CONFIGURAÇÃO (edite aqui) ================== */
  var CONFIG = {
    empresa: "ConcreRiber",
    whatsapp: "5516999999999",            // DDI + DDD + número, só dígitos
    capacidadeCaminhao: 8,                // m³ por caminhão betoneira
