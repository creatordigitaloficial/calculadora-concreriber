    precoM3: { 20: 430, 25: 460, 30: 495, 35: 530 },  // R$ por m³, por fck
    bomba: { taxaFixa: 900, porM3: 25 },  // R$ do serviço de bomba
    alcanceLanca: 35,                     // até quantos metros a bomba lança atende (acima disso: estacionária)
    // Frete por faixa de CEP (5 primeiros dígitos). Fora das faixas: "a confirmar".
    fretes: [
      { de: 14000, ate: 14114, valor: 0,   nome: "Ribeirão Preto" },
      { de: 14115, ate: 14179, valor: 250, nome: "região próxima" }
    ],
    variacaoPreco: 0.08,                  // faixa de +/- 8% na estimativa
    webhook: ""                           // opcional: URL para receber o lead (Make, Zapier, n8n, RD...)
  };
  /* ============================================================== */

  var root = document.getElementById("cc-calc");
  if(!root) return;
  var $ = function(id){ return document.getElementById(id); };
  var estado = { formato:"ret", bomba:"nao", cidade:"", resultado:null };

  var sugestao = {
    laje:     { fck:25, margem:0.05, brita:"brita 1", nome:"laje" },
    fundacao: { fck:25, margem:0.10, brita:"brita 1", nome:"fundação" },
    calcada:  { fck:20, margem:0.05, brita:"brita 1", nome:"calçada / contrapiso" },
    vigas:    { fck:30, margem:0.05, brita:"brita 0", nome:"vigas e pilares" },
    piso:     { fck:30, margem:0.05, brita:"brita 1", nome:"piso de garagem / galpão" }
  };

  function num(v){ v = String(v||"").trim().replace(/\s/g,"").replace(",","."); var n = parseFloat(v); return isNaN(n) ? 0 : n; }
  function fmt(n, casas){ return n.toLocaleString("pt-BR",{minimumFractionDigits:casas,maximumFractionDigits:casas}); }
  function brl(n){ return n.toLocaleString("pt-BR",{style:"currency",currency:"BRL",maximumFractionDigits:0}); }

  // Botões de escolha
  root.querySelectorAll(".cc-choices").forEach(function(g){
    g.addEventListener("click", function(e){
      var b = e.target.closest(".cc-choice"); if(!b) return;
      g.querySelectorAll(".cc-choice").forEach(function(x){ x.classList.remove("is-on"); });
      b.classList.add("is-on");
      estado[g.dataset.group] = b.dataset.value;
      if(g.dataset.group === "formato"){
        root.querySelectorAll("[data-show]").forEach(function(el){ el.hidden = el.dataset.show !== b.dataset.value; });
        if(b.dataset.value === "cil"){ $("cc-tipo").value = "fundacao"; $("cc-fck").value = "25"; }
      }
      if(g.dataset.group === "bomba"){
        $("cc-dist-box").hidden = b.dataset.value !== "nao";
        if(b.dataset.value === "nao") $("cc-dist").focus();
      }
    });
  });

  // Tipo de obra sugere fck
  $("cc-tipo").addEventListener("change", function(){ $("cc-fck").value = String(sugestao[this.value].fck); });

  // CEP: máscara + cidade via ViaCEP
  $("cc-cep").addEventListener("input", function(){
    var d = this.value.replace(/\D/g,"").slice(0,8);
    this.value = d.length > 5 ? d.slice(0,5) + "-" + d.slice(5) : d;
    var info = $("cc-cep-info"); estado.cidade = "";
    if(d.length === 8){
      info.textContent = "Localizando...";
      fetch("https://viacep.com.br/ws/" + d + "/json/").then(function(r){ return r.json(); }).then(function(j){
        if(j.erro){ info.textContent = "CEP não encontrado, confira os números."; return; }
        estado.cidade = j.localidade + "/" + j.uf;
        info.textContent = (j.bairro ? j.bairro + ", " : "") + estado.cidade;
      }).catch(function(){ info.textContent = ""; });
    } else { info.textContent = ""; }
  });

  // WhatsApp: máscara
  $("cc-whats").addEventListener("input", function(){
    var d = this.value.replace(/\D/g,"").slice(0,11);
    if(d.length > 6) this.value = "(" + d.slice(0,2) + ") " + d.slice(2, d.length-4) + "-" + d.slice(-4);
    else if(d.length > 2) this.value = "(" + d.slice(0,2) + ") " + d.slice(2);
    else this.value = d;
  });

  function frete(cep){
    var p = parseInt(String(cep).replace(/\D/g,"").slice(0,5), 10);
    for(var i=0;i<CONFIG.fretes.length;i++){ var f = CONFIG.fretes[i]; if(p >= f.de && p <= f.ate) return f; }
    return null;
  }

  function textoCaminhoes(vol){
    var cap = CONFIG.capacidadeCaminhao;
    var cheios = Math.floor(vol / cap);
    var resto = vol - cheios * cap;
    var partes = [];
    if(cheios > 0) partes.push(cheios + (cheios > 1 ? " caminhões cheios" : " caminhão cheio"));
    if(cheios === 0) return { total: 1, texto: "1 caminhão com " + fmt(vol,1) + " m³", cheios: 0, frac: vol / cap };
    if(resto > 0.05){
      var frac = resto / cap;
      var desc = frac <= 0.3 ? "um caminhão com carga parcial" : frac <= 0.6 ? "meio caminhão" : "quase um caminhão cheio";
      partes.push(desc + " (" + fmt(resto,1) + " m³)");
    }
    return { total: Math.ceil(vol / cap), texto: partes.join(" e ") , cheios: cheios, frac: resto / cap };
  }

  function desenhaCaminhoes(c){
    var box = $("cc-trucks"); box.innerHTML = "";
    var n = Math.min(c.total, 12);
    for(var i=0;i<n;i++){
      var fill = (i < c.cheios) ? 1 : c.frac;
      var w = Math.max(0.15, fill) * 26;
      var d = document.createElement("div"); d.className = "cc-truck";
      d.innerHTML = '<svg viewBox="0 0 58 34"><rect x="2" y="6" width="30" height="18" rx="9" fill="var(--cc-line)"/>' +
        '<rect x="4" y="8" width="'+w.toFixed(1)+'" height="14" rx="7" fill="var(--cc-accent)"/>' +
        '<path d="M34 10h12l8 8v8H34z" fill="var(--cc-ink)"/><rect x="40" y="12" width="7" height="5" rx="1" fill="var(--cc-bg)"/>' +
        '<rect x="2" y="24" width="52" height="3" fill="var(--cc-ink)"/>' +
        '<circle cx="12" cy="29" r="4" fill="var(--cc-ink)"/><circle cx="26" cy="29" r="4" fill="var(--cc-ink)"/><circle cx="46" cy="29" r="4" fill="var(--cc-ink)"/></svg>';
      box.appendChild(d);
    }
  }

  function calcular(){
    var err = $("cc-error"); err.textContent = "";
    var volBase = 0, qtd;
    if(estado.formato === "ret"){
      var c = num($("cc-comp").value), l = num($("cc-larg").value), e = num($("cc-esp").value);
      qtd = Math.max(1, Math.round(num($("cc-qtd-ret").value)) || 1);
      if(!c || !l || !e){ err.textContent = "Preencha comprimento, largura e espessura para calcular."; return; }
      if(e > 3){ err.textContent = "A espessura parece alta. Lembre que 10 cm = 0,10 m."; return; }
      volBase = c * l * e * qtd;
    } else {
      var dm = num($("cc-diam").value), p = num($("cc-prof").value);
      qtd = Math.max(1, Math.round(num($("cc-qtd-cil").value)) || 1);
      if(!dm || !p){ err.textContent = "Preencha diâmetro e profundidade para calcular."; return; }
      if(dm > 3){ err.textContent = "O diâmetro parece alto. Lembre que 30 cm = 0,30 m."; return; }
      volBase = Math.PI * Math.pow(dm/2, 2) * p * qtd;
    }
    var cep = $("cc-cep").value.replace(/\D/g,"");
    if(cep.length !== 8){ err.textContent = "Informe o CEP da obra para incluirmos a logística de entrega."; return; }

    var distancia = 0;
    if(estado.bomba === "nao"){
      distancia = num($("cc-dist").value);
      if(!distancia){ $("cc-dist").focus(); err.textContent = "Informe a distância aproximada até o ponto de lançamento."; return; }
    }
    var tipoBomba = distancia > CONFIG.alcanceLanca ? "bomba estacionária" : "bomba lança";

    var tipo = $("cc-tipo").value, s = sugestao[tipo];
    var margem = s.margem + (estado.bomba === "nao" ? 0.02 : 0);
    var volTotal = Math.ceil(volBase * (1 + margem) * 2) / 2; // arredonda para cima de 0,5 em 0,5 m³
    if(CONFIG.pedidoMinimo && volTotal < CONFIG.pedidoMinimo) volTotal = CONFIG.pedidoMinimo;
    var fck = parseInt($("cc-fck").value, 10);
    var cam = textoCaminhoes(volTotal);
    var comBomba = estado.bomba === "nao";

    estado.resultado = { volBase:volBase, volTotal:volTotal, margem:margem, fck:fck, tipo:s.nome, brita:s.brita, cam:cam, comBomba:comBomba, distancia:distancia, tipoBomba:tipoBomba, cep:$("cc-cep").value };

    $("cc-vol-total").textContent = fmt(volTotal,1) + " m³";
    $("cc-vol-detalhe").textContent = "Medida exata de " + fmt(volBase,2) + " m³ + " + Math.round(margem*100) + "% de margem de segurança";
    $("cc-caminhoes").textContent = cam.total;
    $("cc-caminhoes-txt").textContent = cam.texto + ". Cada caminhão leva até " + CONFIG.capacidadeCaminhao + " m³.";
    desenhaCaminhoes(cam);

    var r = [];
    r.push("Margem de " + Math.round(margem*100) + "% incluída para cobrir irregularidades do solo, abertura das fôrmas" + (comBomba ? " e o volume que fica na tubulação da bomba." : ".") + " Assim a concretagem termina de uma vez, sem emenda.");
    r.push("Concreto " + fck + " MPa com " + s.brita + ", indicado para " + s.nome + ".");
    r.push(comBomba
      ? "Bomba de concreto incluída (" + tipoBomba + ", " + fmt(distancia,0) + " m até o ponto de lançamento): o material chega ao ponto exato em minutos, mantém a trabalhabilidade e reduz a mão de obra no dia."
      : "Descarga direto da bica do caminhão: mais economia, já que o acesso permite.");
    if(CONFIG.pedidoMinimo && volBase * (1+margem) < CONFIG.pedidoMinimo) r.push("Volume ajustado para o pedido mínimo de " + CONFIG.pedidoMinimo + " m³ por entrega.");
    $("cc-resumo").innerHTML = r.map(function(t){ return "<li>" + t + "</li>"; }).join("");

    $("cc-result").hidden = false;
    if($("cc-price").hidden === false) mostraPreco(); // já liberado: atualiza
    $("cc-result").scrollIntoView({behavior:"smooth", block:"start"});
  }

  function mostraPreco(){
    var R = estado.resultado; if(!R) return;
    var pm3 = CONFIG.precoM3[R.fck] || CONFIG.precoM3[25];
    var concreto = R.volTotal * pm3;
    var bomba = R.comBomba ? CONFIG.bomba.taxaFixa + CONFIG.bomba.porM3 * R.volTotal : 0;
    var f = frete(R.cep);
    var fr = f ? f.valor : 0;
    var total = concreto + bomba + fr;
    var v = CONFIG.variacaoPreco;
    $("cc-preco").textContent = brl(total*(1-v)) + " a " + brl(total*(1+v));
    var li = [];
    li.push(["Concreto " + R.fck + " MPa (" + fmt(R.volTotal,1) + " m³)", brl(concreto)]);
    if(R.comBomba) li.push(["Serviço de " + R.tipoBomba + " (" + fmt(R.distancia,0) + " m)", brl(bomba)]);
    li.push(["Frete" + (f ? " (" + f.nome + ")" : ""), f ? (fr ? brl(fr) : "incluso") : "a confirmar"]);
    $("cc-price-list").innerHTML = li.map(function(x){ return "<li><span>"+x[0]+"</span><strong>"+x[1]+"</strong></li>"; }).join("");

    var nome = $("cc-nome").value.trim().split(" ")[0];
    var msg = "Olá, sou " + nome + "! Usei a calculadora do site e vi que preciso de " + fmt(R.volTotal,1) +
      " m³ de concreto (" + R.fck + " MPa) para " + R.tipo + (R.comBomba ? ", com serviço de bomba (" + fmt(R.distancia,0) + " m do caminhão até o ponto de lançamento)" : ", com descarga direta do caminhão") +
      ", para o CEP " + R.cep + (estado.cidade ? " (" + estado.cidade + ")" : "") + ". Podemos fechar o orçamento?";
    $("cc-wa").href = "https://wa.me/" + CONFIG.whatsapp + "?text=" + encodeURIComponent(msg);
  }

  $("cc-calcular").addEventListener("click", calcular);

  $("cc-liberar").addEventListener("click", function(){
    var err = $("cc-error");
    var nome = $("cc-nome").value.trim(), tel = $("cc-whats").value.replace(/\D/g,"");
    if(nome.length < 2){ $("cc-nome").focus(); err.textContent = "Informe seu nome para liberar o preço."; return; }
    if(tel.length < 10){ $("cc-whats").focus(); err.textContent = "Informe um WhatsApp com DDD para liberar o preço."; return; }
    err.textContent = "";
    $("cc-lock").hidden = true; $("cc-price").hidden = false;
    mostraPreco();

    var R = estado.resultado;
    var lead = { nome:nome, whatsapp:tel, volume_m3:R.volTotal, fck:R.fck, tipo_obra:R.tipo, bomba:R.comBomba, distancia_m:R.distancia, tipo_bomba:R.comBomba ? R.tipoBomba : "", cep:R.cep, cidade:estado.cidade, origem:"calculadora-concreto", data:new Date().toISOString() };
    if(CONFIG.webhook){ try{ fetch(CONFIG.webhook,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(lead),mode:"no-cors"}); }catch(e){} }
    if(window.dataLayer) window.dataLayer.push({ event:"lead_calculadora_concreto", volume_m3:R.volTotal });
    if(window.fbq) window.fbq("track","Lead");
    if(window.gtag) window.gtag("event","generate_lead",{ value:R.volTotal });
  });

  $("cc-wa").addEventListener("click", function(){
    if(window.dataLayer) window.dataLayer.push({ event:"clique_whatsapp_calculadora" });
    if(window.fbq) window.fbq("track","Contact");
  });
})();
</script>
